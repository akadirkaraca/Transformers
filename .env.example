# Telegram training notifications (optional)
# Copy this file to .env and fill in your credentials.
# .env is excluded from version control — never commit it.
#
# How to get these values:
#   1. Create a bot via @BotFather on Telegram → gives you TELEGRAM_BOT_TOKEN
#   2. Send a message to your bot, then open:
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#      Look for "chat" → "id" in the response → that is TELEGRAM_CHAT_ID

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
